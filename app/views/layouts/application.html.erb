<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "MacroTrack" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="MacroTrack">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#0f172a">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="<%= pwa_manifest_path %>">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>

    <%# Turbo forces a full load when a `data-turbo-track="reload"` element changes, which
        is how the stylesheet above survives a deploy. Nothing importmap_tags renders
        carries that attribute — the map is inline and the preload links are bare — so an
        app left open since before a deploy keeps running the JavaScript it booted with,
        and Turbo swapping the body never re-imports a module. That is how the dictation
        fix of 22 August reached the phone and did nothing until it was reloaded by hand.
        This digest covers every pinned module's digested path, so it moves when any of
        them does. %>
    <meta name="importmap-digest" data-turbo-track="reload"
          content="<%= Rails.application.importmap.digest(resolver: self) %>">
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased">
    <% if authenticated? %>
      <%= render "shared/header_strip", user: Current.user, date: @header_date || Current.user.local_today %>
    <% end %>

    <main class="mx-auto w-full max-w-xl px-4 pb-24 <%= authenticated? ? "pt-4" : "pt-10" %>">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
