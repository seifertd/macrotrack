<!DOCTYPE html>
<html>
  <head>
    <title>MacroTrack Build Plan</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#0f172a">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">

    <%# Standalone styling rather than the app's Tailwind: this is a long-form
        document, not an app screen, and it wants document typography. %>
    <%= render "plan/styles" %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
