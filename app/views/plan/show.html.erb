<div class="wrap">
  <% unless local_assigns[:standalone] %>
    <%= link_to "← Back to today", root_path, class: "backlink" %>
  <% end %>

  <header class="masthead">
    <div class="masthead__eyebrow">Implementation plan</div>
    <h1>MacroTrack</h1>
    <p>A calorie and macro tracker for the two of us. This is the build order — what is finished, what is next, and why each decision went the way it did.</p>
  </header>

  <div class="status">
    <div class="status__cell">
      <span class="status__k">Finished</span>
      <span class="status__v"><%= @packages.count { |p| p.state == "done" } %> of <%= @packages.size %></span>
      <span class="status__note">Deployed, on the phone, backed up</span>
    </div>
    <% up_next = @packages.find { |package| package.state == "next" } %>
    <div class="status__cell">
      <span class="status__k">Next</span>
      <span class="status__v"><%= up_next&.label %></span>
      <span class="status__note"><%= up_next&.title %></span>
    </div>
    <div class="status__cell">
      <span class="status__k">Updated</span>
      <span class="status__v"><%= PlanDocument.updated_at.strftime("%-d %b") %></span>
      <span class="status__note">Rendered from the deployed release</span>
    </div>
  </div>

  <nav class="toc" aria-label="Work packages">
    <p class="toc__k">Work packages — in build order</p>
    <ol class="toc__list">
      <% @packages.each do |package| %>
        <li class="toc__item">
          <a class="toc__link" href="#<%= package.anchor %>">
            <span class="toc__dot toc__dot--<%= package.state %>" aria-hidden="true"></span>
            <span class="toc__num"><%= package.label %></span>
            <span class="toc__title"><%= package.title %></span>
          </a>
        </li>
      <% end %>
    </ol>
  </nav>

  <main class="flow">
    <%= @body %>
  </main>

  <p class="colophon">
    Rendered from <code>doc/IMPLEMENTATION-PLAN.md</code> in the running release, so this page
    cannot drift from the code it describes.
  </p>
</div>
