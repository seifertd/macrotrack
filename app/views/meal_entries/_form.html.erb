<%= form_with model: meal_entry, url: url, class: "mt-3 space-y-3" do |form| %>
  <% field = "w-full rounded-lg border border-slate-300 px-3 py-2 text-base focus:outline-blue-600" %>
  <% label = "block text-xs font-medium text-slate-600" %>

  <div>
    <%= form.label :food_name, "What", class: label %>
    <%= form.text_field :food_name, required: true, autocomplete: "off",
          placeholder: "chicken burrito bowl", class: field %>
  </div>

  <%# Every one of these columns is a decimal, and only the ones typed here arrive whole.
      An entry logged off a food is a per-100g figure scaled by a portion — 28g of havarti
      is 108.45 kcal — so a step the browser can round to rejects the number the row was
      saved with, on the screen whose only job is to change it. `any` is the honest step
      for a decimal column; the display helpers still round every figure the day page
      shows. `decimal` inputmode for the same reason: a numeric keypad has no point on it. %>
  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= form.label :calories, "Calories", class: label %>
      <%= form.number_field :calories, required: true, step: :any, min: 0,
            inputmode: "decimal", class: field %>
    </div>
    <div>
      <%= form.label :quantity_grams, "Grams", class: label %>
      <%= form.number_field :quantity_grams, step: :any, min: 0, inputmode: "decimal", class: field %>
    </div>
  </div>

  <div class="grid grid-cols-3 gap-3">
    <div>
      <%= form.label :protein_g, "Protein", class: label %>
      <%= form.number_field :protein_g, step: :any, min: 0, inputmode: "decimal", class: field %>
    </div>
    <div>
      <%= form.label :fat_g, "Fat", class: label %>
      <%= form.number_field :fat_g, step: :any, min: 0, inputmode: "decimal", class: field %>
    </div>
    <div>
      <%= form.label :carbs_g, "Carbs", class: label %>
      <%= form.number_field :carbs_g, step: :any, min: 0, inputmode: "decimal", class: field %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= form.label :meal_type, "Meal", class: label %>
      <%= form.select :meal_type, MealEntry::MEAL_TYPES, { include_blank: "—" }, class: field %>
    </div>
    <div>
      <%= form.label :consumed_at, "When", class: label %>
      <%= form.datetime_field :consumed_at, required: true, include_seconds: false, class: field %>
    </div>
  </div>

  <%= form.submit submit_label,
        class: "w-full cursor-pointer rounded-lg bg-blue-600 px-4 py-2.5 font-medium text-white hover:bg-blue-500" %>
<% end %>
