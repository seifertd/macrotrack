<% content_for :title, "Add — MacroTrack" %>
<% today = @date == Current.user.local_today %>

<div class="flex items-center justify-between">
  <h1 class="text-lg font-semibold">Add</h1>
  <%= link_to today ? "Back" : "Back to #{@date.strftime("%-d %b")}", day_path(@date),
        class: "text-sm text-slate-500 underline hover:no-underline" %>
</div>

<%# Say which day this lands on whenever it isn't today, same as the header strip: the
    screen was opened from a day, and it keeps logging to that day. %>
<p class="mt-0.5 text-sm text-slate-500">
  <% if today %>
    Five ways in. All of them land on today.
  <% else %>
    Five ways in. All of them land on
    <span class="rounded bg-slate-100 px-1.5 py-0.5 text-xs font-medium text-slate-600">
      <%= @date.strftime("%-d %b") %>
    </span>.
  <% end %>
</p>

<%# WP5-a. The tap that starts the recogniser has to be the gesture the browser sees, so
    this listens here rather than sending you to the chat screen to tap again — which is
    the whole point, one tap from this screen to a logged meal. The post is deliberately
    not a Turbo submit: it lands on the chat screen by ordinary redirect, with the answer
    already on its way. Where the browser has no recogniser the button removes itself and
    the row below is what you wanted anyway. %>
<%= form_with url: chat_messages_path, data: { turbo: false, controller: "dictation" } do |form| %>
  <%= form.hidden_field "chat_message[text]", data: { dictation_target: "field" } %>
  <%= form.hidden_field "chat_message[input_source]", value: "voice",
        data: { dictation_target: "source" } %>

  <button type="button" data-dictation-target="button" data-action="dictation#toggle"
          class="mt-4 flex w-full items-center justify-between rounded-xl bg-slate-900 px-4 py-3 text-left text-white">
    <span class="flex items-center gap-2 font-semibold">
      <%= render "shared/mic_icon" %>
      Speak it
    </span>
    <span class="text-sm text-slate-300">Tap, say what you ate, press Done →</span>
  </button>

  <p data-dictation-target="status" class="mt-1 px-1 text-xs text-slate-500 empty:hidden"></p>

  <%= render "shared/dictation_overlay" %>
<% end %>

<%= link_to chat_path,
      class: "mt-2 flex items-center justify-between rounded-xl border border-slate-300 bg-white px-4 py-3" do %>
  <span class="font-semibold">Log by chat</span>
  <span class="text-sm text-slate-500">Type it, or dictate with the keyboard →</span>
<% end %>

<%# Ahead of the repeat picker because design §6 orders the paths that way: a label is
    ground truth, a previous entry is only as good as the entry it came from. %>
<%= link_to scan_path,
      class: "mt-2 flex items-center justify-between rounded-xl border border-slate-300 bg-white px-4 py-3" do %>
  <span class="font-semibold">Scan a barcode</span>
  <span class="text-sm text-slate-500">Straight off the label →</span>
<% end %>

<%= link_to repeats_path,
      class: "mt-2 flex items-center justify-between rounded-xl border border-slate-300 bg-white px-4 py-3" do %>
  <span class="font-semibold">Find a food</span>
  <span class="text-sm text-slate-500">What you've eaten, or anything on file →</span>
<% end %>

<section class="mt-4 rounded-xl border border-slate-200 bg-white p-4">
  <h2 class="font-semibold">Or type the numbers</h2>
  <p class="mt-0.5 text-xs text-slate-500">Manual entry, for when you already know them.</p>
  <%= render "meal_entries/form", meal_entry: @meal_entry, url: meal_entries_path, submit_label: "Log it" %>
</section>
