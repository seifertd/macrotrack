<% content_for :title, "Add — MacroTrack" %>
<% today = @date == Current.user.local_today %>

<div class="flex items-center justify-between">
  <h1 class="text-lg font-semibold">Add</h1>
  <%= link_to today ? "Back" : "Back to #{@date.strftime("%-d %b")}", day_path(@date),
        class: "text-sm text-slate-500 underline hover:no-underline" %>
</div>

<%# Say which day this lands on whenever it isn't today, same as the header strip: the
    screen was opened from a day, and it keeps logging to that day. %>
<p class="mt-0.5 text-sm text-slate-500">
  <% if today %>
    Four ways in. All of them land on today.
  <% else %>
    Four ways in. All of them land on
    <span class="rounded bg-slate-100 px-1.5 py-0.5 text-xs font-medium text-slate-600">
      <%= @date.strftime("%-d %b") %>
    </span>.
  <% end %>
</p>

<%= link_to chat_path,
      class: "mt-4 flex items-center justify-between rounded-xl bg-slate-900 px-4 py-3 text-white" do %>
  <span class="font-semibold">Log by chat</span>
  <span class="text-sm text-slate-300">Just say what you ate →</span>
<% end %>

<%# Ahead of the repeat picker because design §6 orders the paths that way: a label is
    ground truth, a previous entry is only as good as the entry it came from. %>
<%= link_to scan_path,
      class: "mt-2 flex items-center justify-between rounded-xl border border-slate-300 bg-white px-4 py-3" do %>
  <span class="font-semibold">Scan a barcode</span>
  <span class="text-sm text-slate-500">Straight off the label →</span>
<% end %>

<%= link_to repeats_path,
      class: "mt-2 flex items-center justify-between rounded-xl border border-slate-300 bg-white px-4 py-3" do %>
  <span class="font-semibold">Find a food</span>
  <span class="text-sm text-slate-500">What you've eaten, or anything on file →</span>
<% end %>

<section class="mt-4 rounded-xl border border-slate-200 bg-white p-4">
  <h2 class="font-semibold">Or type the numbers</h2>
  <p class="mt-0.5 text-xs text-slate-500">Manual entry, for when you already know them.</p>
  <%= render "meal_entries/form", meal_entry: @meal_entry, url: meal_entries_path, submit_label: "Log it" %>
</section>
