<% content_for :title, "Unknown barcode — MacroTrack" %>

<%= link_to "‹ Scan another", scan_path, class: "text-sm text-slate-500 underline hover:no-underline" %>

<h1 class="mt-2 text-lg font-semibold">We don't know this one yet</h1>
<p class="mt-0.5 text-sm text-slate-500">
  Nothing in OpenFoodFacts for <span class="tabular-nums"><%= @barcode %></span>. Copy the
  numbers off the label once and every future scan of it — yours or
  <%= @user.household_members.first&.name || "the other phone" %>'s — will just work.
</p>

<%= form_with model: @food, url: adopt_scan_path(@barcode), method: :post, class: "mt-4" do |form| %>
  <% if @food.errors.any? %>
    <div class="mb-3 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900">
      <%= @food.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="rounded-xl border border-slate-200 bg-white p-4">
    <%= form.label :name, "What is it?", class: "block text-sm font-medium" %>
    <%= form.text_field :name, placeholder: "Oui black cherry yogurt", autofocus: true,
          class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2 text-base focus:border-slate-500 focus:outline-none" %>

    <p class="mt-4 text-sm font-medium">Per 100g, from the label</p>
    <p class="mt-0.5 text-xs text-slate-500">
      Use the "per 100g" column, not the per-serving one — that's the column this app stores.
    </p>

    <div class="mt-3 grid grid-cols-2 gap-3">
      <div>
        <%= form.label :calories_per_100g, "Calories", class: "block text-xs text-slate-500" %>
        <%= form.number_field :calories_per_100g, step: 0.1, min: 0, inputmode: "decimal",
              class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-base tabular-nums focus:border-slate-500 focus:outline-none" %>
      </div>
      <div>
        <%= form.label :protein_per_100g, "Protein (g)", class: "block text-xs text-slate-500" %>
        <%= form.number_field :protein_per_100g, step: 0.1, min: 0, inputmode: "decimal",
              class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-base tabular-nums focus:border-slate-500 focus:outline-none" %>
      </div>
      <div>
        <%= form.label :fat_per_100g, "Fat (g)", class: "block text-xs text-slate-500" %>
        <%= form.number_field :fat_per_100g, step: 0.1, min: 0, inputmode: "decimal",
              class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-base tabular-nums focus:border-slate-500 focus:outline-none" %>
      </div>
      <div>
        <%= form.label :carbs_per_100g, "Carbs (g)", class: "block text-xs text-slate-500" %>
        <%= form.number_field :carbs_per_100g, step: 0.1, min: 0, inputmode: "decimal",
              class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-base tabular-nums focus:border-slate-500 focus:outline-none" %>
      </div>
    </div>
  </section>

  <div class="mt-4">
    <%= form.submit "Save it",
          class: "w-full cursor-pointer rounded-xl bg-slate-900 px-4 py-3 font-semibold text-white hover:bg-slate-700" %>
  </div>
<% end %>
