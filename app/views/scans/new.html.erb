<% content_for :title, "Scan a barcode — MacroTrack" %>

<div class="flex items-center justify-between">
  <h1 class="text-lg font-semibold">Scan a barcode</h1>
  <%= link_to "Today →", day_path(@user.local_today),
        class: "text-sm text-slate-500 underline hover:no-underline" %>
</div>
<p class="mt-0.5 text-sm text-slate-500">
  Point the camera at the barcode. The label is read exactly — nothing is estimated.
</p>

<div class="mt-4"
     data-controller="barcode"
     data-barcode-base-path-value="<%= scan_path %>">

  <%# Hidden until the camera is live, so an unsupported browser never shows a black box. %>
  <div class="relative hidden overflow-hidden rounded-xl border border-slate-200 bg-slate-900"
       data-barcode-target="stage">
    <video class="block w-full" playsinline muted data-barcode-target="video"></video>
    <div class="pointer-events-none absolute inset-x-6 top-1/2 h-24 -translate-y-1/2 rounded-lg border-2 border-white/70"></div>
  </div>

  <p class="mt-3 text-center text-sm text-slate-500" data-barcode-target="status">
    Starting the camera…
  </p>

  <%# The only path that works everywhere, and the fallback when the camera is refused
      or BarcodeDetector is missing. Also the fastest way to test on a laptop. %>
  <%= form_with url: lookup_scan_path, method: :get, class: "mt-6" do %>
    <label class="block text-sm font-medium" for="barcode">Or type the number under the bars</label>
    <div class="mt-2 flex gap-2">
      <%= text_field_tag :barcode, nil, inputmode: "numeric", autocomplete: "off", pattern: '\d{6,14}',
            placeholder: "0123456789012",
            class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-base tabular-nums focus:border-slate-500 focus:outline-none",
            data: { barcode_target: "manualInput" } %>
      <%= submit_tag "Look up",
            class: "shrink-0 cursor-pointer rounded-lg bg-slate-900 px-4 py-2 font-semibold text-white hover:bg-slate-700" %>
    </div>
  <% end %>
</div>
