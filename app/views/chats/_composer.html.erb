<%# Replaced wholesale on submit, which is what empties the field — no JS needed. %>
<%= form_with url: chat_messages_path, id: "composer", data: { controller: "dictation" } do |form| %>
  <p data-dictation-target="status" class="px-1 pb-1 text-xs text-slate-500 empty:hidden"></p>

  <div class="flex gap-2">
    <%# Says "text" until the recogniser has actually heard something — see dictation#send. %>
    <%= form.hidden_field "chat_message[input_source]", value: "text",
          data: { dictation_target: "source" } %>
    <%= form.text_field "chat_message[text]",
          autocomplete: "off",
          autofocus: true,
          placeholder: "What did you eat?",
          data: { dictation_target: "field" },
          class: "min-w-0 flex-1 rounded-full border border-slate-300 px-4 py-2.5 text-base focus:border-slate-500 focus:outline-none" %>
    <%# Removes itself where the browser has no recogniser, which is why there is no
        explanatory copy: the field next to it is the answer. %>
    <button type="button" data-dictation-target="button" data-action="dictation#toggle"
            aria-label="Dictate"
            class="shrink-0 rounded-full border border-slate-300 px-3.5 py-2.5 text-slate-700 hover:bg-slate-50">
      <%= render "shared/mic_icon" %>
    </button>
    <%= form.submit "Send",
          class: "shrink-0 rounded-full bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-slate-700" %>
  </div>
<% end %>
