<%# Replaced wholesale on submit, which is what empties the field — no JS needed. %>
<%= form_with url: chat_messages_path, id: "composer", class: "flex gap-2" do |form| %>
  <%= form.text_field "chat_message[text]",
        autocomplete: "off",
        autofocus: true,
        placeholder: "What did you eat?",
        class: "min-w-0 flex-1 rounded-full border border-slate-300 px-4 py-2.5 text-base focus:border-slate-500 focus:outline-none" %>
  <%= form.submit "Send",
        class: "shrink-0 rounded-full bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-slate-700" %>
<% end %>
