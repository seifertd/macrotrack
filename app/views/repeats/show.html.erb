<% content_for :title, "#{@source.display_name} — MacroTrack" %>
<% members = @user.household_members %>

<%= link_to "‹ Back", repeats_path, class: "text-sm text-slate-500 underline hover:no-underline" %>

<h1 class="mt-2 text-lg font-semibold"><%= @source.display_name %></h1>
<p class="mt-0.5 text-sm text-slate-500">
  <%= @source.user == @user ? "You" : @source.user.name %> logged
  <%= calories(@source.calories) %> kcal<% if @source.quantity_grams.present? %>
  for <%= grams(@source.quantity_grams) %><% end %>.
</p>

<%= form_with url: log_repeat_path(@source), method: :post,
      data: {
        controller: "portion",
        portion_calories_value: @source.calories.to_f,
        portion_protein_value: @source.protein_g.to_f,
        portion_fat_value: @source.fat_g.to_f,
        portion_carbs_value: @source.carbs_g.to_f,
        portion_grams_value: @source.quantity_grams.to_f
      } do %>

  <section class="mt-4 rounded-xl border border-slate-200 bg-white p-4">
    <% if @portion.by_grams? %>
      <label class="block text-sm font-medium" for="grams">How much did you have?</label>
      <div class="mt-2 flex items-center gap-2">
        <%= number_field_tag :grams, @source.quantity_grams.to_f.round, step: 1, min: 1, inputmode: "numeric",
              class: "w-32 rounded-lg border border-slate-300 px-3 py-2 text-base tabular-nums focus:border-slate-500 focus:outline-none",
              data: { portion_target: "grams", action: "input->portion#recalculate" } %>
        <span class="text-sm text-slate-500">grams</span>
      </div>
    <% else %>
      <p class="text-sm font-medium">How much did you have?</p>
      <p class="mt-0.5 text-xs text-slate-500">This one wasn't weighed, so pick a share of it.</p>
      <%= hidden_field_tag :multiplier, 1, data: { portion_target: "multiplier" } %>
    <% end %>

    <%# Offered either way: "half of what he had" is often the honest answer. %>
    <div class="mt-3 flex flex-wrap gap-2">
      <% MealPortion::MULTIPLIERS.each do |multiplier| %>
        <button type="button"
                class="rounded-full border border-slate-300 px-3 py-1.5 text-sm font-medium hover:bg-slate-100"
                data-portion-target="chip"
                data-multiplier="<%= multiplier %>"
                data-action="portion#choose">
          <%= "#{format('%g', multiplier)}×" %>
        </button>
      <% end %>
    </div>
  </section>

  <%# The number is confirmed before it's saved, not after. %>
  <section class="mt-3 rounded-xl border border-slate-200 bg-white p-4">
    <div class="flex items-baseline justify-between">
      <span class="text-sm text-slate-500">That's</span>
      <div class="text-right">
        <p class="text-2xl font-semibold tabular-nums">
          <span data-portion-target="calories"><%= calories(@source.calories) %></span>
          <span class="text-sm font-normal text-slate-500">kcal</span>
        </p>
        <p class="text-xs tabular-nums text-slate-500">
          <span data-portion-target="protein"><%= grams(@source.protein_g) %></span>P
          <span data-portion-target="fat"><%= grams(@source.fat_g) %></span>F
          <span data-portion-target="carbs"><%= grams(@source.carbs_g) %></span>C
        </p>
      </div>
    </div>
  </section>

  <div class="mt-4 flex flex-col gap-2">
    <%# A button rather than submit_tag: the label and the submitted value differ, and
        submit_tag ties them together. %>
    <%= button_tag "For me", type: :submit, name: "target_id", value: @user.id,
          class: "w-full rounded-xl bg-slate-900 px-4 py-3 font-semibold text-white hover:bg-slate-700" %>
    <% members.each do |member| %>
      <%= button_tag "For #{member.name}", type: :submit, name: "target_id", value: member.id,
            class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-semibold hover:bg-slate-50" %>
    <% end %>
  </div>
<% end %>
