<%# The portion question for a `foods` row, shared by the scanner and the food picker.
    Identical on both because the question is: a density and a package, and how much of
    it you had. Only the way you arrived differs, so only the header above this does.

    `portion` is a FoodPortion; `url` is where the answer posts. %>
<% base = portion.reference_scaled %>

<%# Named only when the food knows what a serving weighs. Without it there is nothing
    honest to say, and "1 serving" would be a guess dressed as a fact. %>
<% if portion.by_serving? %>
  <p class="mt-1 text-sm font-medium text-slate-700">
    1 serving = <%= grams(portion.food.serving_g) %><% if portion.food.serving_label.present? %>
    <span class="font-normal text-slate-500">(<%= portion.food.serving_label %>)</span><% end %>
  </p>
<% end %>

<%= form_with url: url, method: :post,
      data: {
        controller: "portion",
        portion_calories_value: base[:calories].to_f,
        portion_protein_value: base[:protein_g].to_f,
        portion_fat_value: base[:fat_g].to_f,
        portion_carbs_value: base[:carbs_g].to_f,
        portion_grams_value: portion.reference_grams.to_f
      } do %>

  <section class="mt-4 rounded-xl border border-slate-200 bg-white p-4">
    <label class="block text-sm font-medium" for="grams">How much did you have?</label>
    <div class="mt-2 flex items-center gap-2">
      <%= number_field_tag :grams, portion.reference_grams.to_f.round, step: 1, min: 1, inputmode: "numeric",
            class: "w-32 rounded-lg border border-slate-300 px-3 py-2 text-base tabular-nums focus:border-slate-500 focus:outline-none",
            data: { portion_target: "grams", action: "input->portion#recalculate" } %>
      <span class="text-sm text-slate-500">grams</span>
    </div>

    <%# Servings when the food has one, gram presets when it doesn't. Both set the grams
        field, so it stays the single source of truth and can still be nudged after. %>
    <div class="mt-3 flex flex-wrap gap-2">
      <% portion.chips.each do |chip| %>
        <button type="button"
                class="rounded-full border border-slate-300 px-3 py-1.5 text-sm font-medium tabular-nums hover:bg-slate-100"
                data-portion-target="chip"
                data-multiplier="<%= chip[:multiplier] %>"
                data-action="portion#choose">
          <%= chip[:label] %>
        </button>
      <% end %>
    </div>
  </section>

  <section class="mt-3 rounded-xl border border-slate-200 bg-white p-4">
    <div class="flex items-baseline justify-between">
      <span class="text-sm text-slate-500">That's</span>
      <div class="text-right">
        <p class="text-2xl font-semibold tabular-nums">
          <span data-portion-target="calories"><%= calories(base[:calories]) %></span>
          <span class="text-sm font-normal text-slate-500">kcal</span>
        </p>
        <p class="text-xs tabular-nums text-slate-500">
          <span data-portion-target="protein"><%= grams(base[:protein_g]) %></span>P
          <span data-portion-target="fat"><%= grams(base[:fat_g]) %></span>F
          <span data-portion-target="carbs"><%= grams(base[:carbs_g]) %></span>C
        </p>
      </div>
    </div>
  </section>

  <div class="mt-4">
    <%= submit_tag "Log it",
          class: "w-full cursor-pointer rounded-xl bg-slate-900 px-4 py-3 font-semibold text-white hover:bg-slate-700" %>
  </div>
<% end %>
