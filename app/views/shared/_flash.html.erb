<% if alert = flash[:alert] %>
  <p id="alert" class="mb-4 rounded-lg bg-rose-50 px-3 py-2 text-sm font-medium text-rose-700"><%= alert %></p>
<% end %>

<% if notice = flash[:notice] %>
  <p id="notice" class="mb-4 rounded-lg bg-emerald-50 px-3 py-2 text-sm font-medium text-emerald-700"><%= notice %></p>
<% end %>
